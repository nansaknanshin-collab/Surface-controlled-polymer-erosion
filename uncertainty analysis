# RUN GRADES (in parallel when possible)
# ================================================================

def this_script():
    try:
        p = Path(__file__).resolve()
        return p if p.exists() else None
    except NameError:
        return None


def run_all():

    pending = [g for g in GRADE_ORDER if not (ROOT_OUTPUT_DIR / f"{g}_DONE.pkl").exists()]

    print(
        f"NIWA / van Mourik et al. (2014) | chains = {N_CHAINS}, iterations = {N_ITER}, "
        f"thin = {N_THIN}, sample = {N_SAMPLE} | bounds = {BOUNDS_MODE} | "
        f"grades to run: {pending}",
        flush=True,
    )

    script = this_script()

    if N_PARALLEL > 1 and len(pending) > 1 and script is not None:

        import subprocess

        procs = {}
        queue = list(pending)
        last = 0.0

        while queue or procs:

            while queue and len(procs) < N_PARALLEL:
                g = queue.pop(0)
                fh = open(ROOT_OUTPUT_DIR / f"STDOUT_{g}.txt", "a")
                procs[g] = (subprocess.Popen(
                    [sys.executable, "-u", str(script), "--grade", g],
                    stdout=fh, stderr=subprocess.STDOUT, cwd=str(script.parent)), fh)
                print(f"STARTED  | {g}", flush=True)

            for g in list(procs):
                p, fh = procs[g]
                if p.poll() is not None:
                    fh.close()
                    del procs[g]
                    ok = (ROOT_OUTPUT_DIR / f"{g}_DONE.pkl").exists()
                    print(f"{'FINISHED' if ok else 'ERROR   '} | {g}", flush=True)
                    make_figures()
                    write_master()

            if procs and time.time() - last > 600:
                last = time.time()
                print(time.strftime("[%H:%M] progress"), flush=True)
                for g in procs:
                    try:
                        lines = (ROOT_OUTPUT_DIR / f"LOG_{g}.txt").read_text().splitlines()
                        print(f"   {g}: {lines[-1] if lines else 'starting'}", flush=True)
                    except OSError:
                        print(f"   {g}: starting", flush=True)

            time.sleep(5)

    elif N_PARALLEL > 1 and len(pending) > 1:

        try:
            from joblib import Parallel, delayed
            print("Interactive run: joblib workers. Progress in LOG_*.txt", flush=True)
            Parallel(n_jobs=min(N_PARALLEL, len(pending)), backend="loky", verbose=10)(
                delayed(analyse_grade)(g) for g in pending)
        except ImportError:
            for g in pending:
                analyse_grade(g)

    else:

        for g in pending:
            analyse_grade(g)

    make_figures()
    write_master()

    print(f"\nDONE. Results in {ROOT_OUTPUT_DIR}", flush=True)


if __name__ == "__main__":

    if "--grade" in sys.argv:
        analyse_grade(sys.argv[sys.argv.index("--grade") + 1])
    elif "--figures-only" in sys.argv:
        make_figures()
        write_master()
    else:
        run_all()
