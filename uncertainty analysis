def save_figure(fig, path, **kwargs):
    """
    Save a figure robustly on Windows: write to a temporary file and move
    it into place, retrying if the target is locked (open in a viewer,
    being synced by OneDrive, ...). If it stays locked, save under a new
    name with a time stamp instead of stopping the run.
    """

    path = Path(path)
    tmp = path.with_name(path.stem + "_tmp_writing" + path.suffix)

    for attempt in range(6):
        try:
            fig.savefig(tmp, **kwargs)
            os.replace(tmp, path)
            return path
        except OSError:
            time.sleep(2)

    alt = path.with_name(path.stem + time.strftime("_%Y%m%d_%H%M%S") + path.suffix)
    fig.savefig(alt, **kwargs)
    print(f"WARNING: {path.name} is locked by another program; saved as {alt.name}", flush=True)
    return alt



LABEL = {
    "k1": r"$k_{\mathrm{bind},C}$",
    "k4": r"$k_{\mathrm{bind},A}$",
    "kc": r"$k_c$",
    "ka": r"$k_a$",
    "kr": r"$k_m$",
    "ke": r"$k_e$",
    "De0": r"$D_{e0}$",
    "alpha_pH": r"$\alpha_{\mathrm{pH}}$",
}

THESIS_ORDER = ["k1", "k4", "kc", "ka", "kr", "ke", "De0", "alpha_pH"]
RATES = ["k1", "k4", "kc", "ka", "kr", "ke"]

COLOURS = {"PCL6300": "#1f77b4", "PCL6500": "#ff7f0e", "PCL6800": "#2ca02c"}


def plot_grade_diagnostics(grade, res):

    case_dir = ROOT_OUTPUT_DIR / grade

    # Gelman R history (as in their Main.m figure, 1.2 reference line)
    R = res["R"]
    fig, axs = plt.subplots(2, 4, figsize=(14, 6), sharex=True)
    for ax, p in zip(axs.ravel(), NAMES):
        ax.plot(R["iteration"] * N_CHAINS, R[p])
        ax.axhline(1.2, ls="--", color="tab:red")
        ax.set_ylim(0.5, 1.5)
        ax.set_title(LABEL[p])
        ax.grid(alpha=0.3)
    axs[1, 0].set_xlabel("Iterations")
    axs[1, 0].set_ylabel("Scale reduction")
    fig.tight_layout()
    save_figure(fig, case_dir / f"{grade}_NIWA_Gelman_R.png", dpi=150)
    plt.close(fig)

    # trace plots of the m chains (log10 parameters)
    seq = res["seq"]
    fig, axs = plt.subplots(len(NAMES), 1, figsize=(10, 2 * len(NAMES)), sharex=True)
    for k, p in enumerate(NAMES):
        for c in range(seq.shape[2]):
            axs[k].plot(seq[::max(1, seq.shape[0] // 4000), k, c], lw=0.5)
        axs[k].set_ylabel(r"log$_{10}$ " + LABEL[p])
        # burn-in = first N_ITER/N_THIN saved states = first N_ITER/N_CHAINS iterations
        axs[k].axvline((N_ITER // N_CHAINS) / max(1, seq.shape[0] // 4000), color="k", ls="--")
    axs[-1].set_xlabel("Iteration (subsampled)")
    fig.tight_layout()
    save_figure(fig, case_dir / f"{grade}_NIWA_trace.png", dpi=120)
    plt.close(fig)


def load_grade(grade):

    case_dir = ROOT_OUTPUT_DIR / grade
    f_s = case_dir / f"{grade}_NIWA_sample_{N_SAMPLE}.csv"
    f_c = case_dir / f"{grade}_NIWA_credible_region_states.csv"
    f_e = case_dir / f"{grade}_NIWA_envelope.csv"

    if not (f_s.exists() and f_e.exists()):
        return None

    return {
        "sample": pd.read_csv(f_s),
        "credible": pd.read_csv(f_c) if f_c.exists() else pd.read_csv(f_s),
        "envelope": pd.read_csv(f_e),
    }


def plot_predictions(loaded):

    grades = list(loaded)

    cols = [
        ("WL", "wl_obs", "Weight loss", "Weight loss (%)"),
        ("pH", "ph_obs", "pH", "Bath pH"),
        ("Xc", "xc_obs", r"$X_c$", r"Remaining crystallinity, $X_c$ (%)"),
    ]

    fig, axs = plt.subplots(len(grades), 3, figsize=(13.5, 3.6 * len(grades)), squeeze=False)

    for r, grade in enumerate(grades):

        b = loaded[grade]["envelope"]
        d = DATA[grade]

        for c, (key, obs, title, ylab) in enumerate(cols):

            ax = axs[r, c]

            ax.fill_between(b["time_h"], b[f"{key}_lower"], b[f"{key}_upper"],
                            color="#7fd17f", alpha=0.65, linewidth=0)

            if SHOW_MEAN_LINE:
                ax.plot(b["time_h"], b[f"{key}_mean"], color="red", lw=2.2)

            ax.scatter(T_MAIN, d[obs], color="black", s=22, zorder=5)

            if r == 0:
                ax.set_title(title, fontsize=12)
            ax.set_ylabel(f"{grade}\n{ylab}" if c == 0 else ylab, fontsize=10)
            if r == len(grades) - 1:
                ax.set_xlabel("Time (hours)", fontsize=10)
            ax.set_xlim(-0.5, T_FINAL + 0.5)
            ax.grid(alpha=0.3)
            ax.tick_params(labelsize=8)

    handles = [
        plt.Line2D([0], [0], marker="o", color="black", ls="none", markersize=5),
        plt.Rectangle((0, 0), 1, 1, color="#7fd17f", alpha=0.65),
    ]
    labels = ["Data", "95% prediction uncertainty"]
    if SHOW_MEAN_LINE:
        handles.append(plt.Line2D([0], [0], color="red", lw=2.2))
        labels.append("Posterior mean")

    fig.legend(handles, labels, loc="upper center", ncol=len(labels), frameon=False)
    fig.tight_layout(rect=(0, 0, 1, 0.965))
    save_figure(fig, ROOT_OUTPUT_DIR / "NIWA_predictions_all_grades.png", dpi=DPI, bbox_inches="tight")
    plt.close(fig)


def plot_rectangles(loaded, params, ncols, filename, ylabels):

    grades = list(loaded)
    nrows = int(np.ceil(len(params) / ncols))
    fig, axs = plt.subplots(nrows, ncols, figsize=(4.6 * ncols, 3.9 * nrows), squeeze=False)

    for k, p in enumerate(params):
        ax = axs[k // ncols, k % ncols]
        for j, g in enumerate(grades):
            v = loaded[g]["sample"][p].to_numpy()
            lo, hi = np.percentile(v, [2.5, 97.5])
            ax.add_patch(plt.Rectangle((j - 0.3, lo), 0.6, hi - lo,
                                       facecolor=COLOURS[g], edgecolor="none", alpha=0.9))
            ax.plot([j - 0.3, j + 0.3], [v.mean()] * 2, color="red", lw=2)
        ax.set_xlim(-0.6, len(grades) - 0.4)
        ax.set_xticks(range(len(grades)))
        ax.set_xticklabels(grades, fontsize=8)
        ax.set_title(LABEL[p])
        ax.set_ylabel(ylabels.get(p, "Parameter value"), fontsize=8)
        ax.autoscale(axis="y")
        ax.set_ylim(bottom=0)
        ax.grid(axis="y", alpha=0.25)
        ax.ticklabel_format(axis="y", style="sci", scilimits=(-3, 4))

    for k in range(len(params), nrows * ncols):
        axs[k // ncols, k % ncols].axis("off")

    handles = [plt.Rectangle((0, 0), 1, 1, color=COLOURS[g]) for g in grades]
    handles.append(plt.Line2D([0], [0], color="red", lw=2))
    fig.legend(handles, grades + ["Posterior mean"], loc="upper center",
               ncol=len(grades) + 1, frameon=False)
    fig.tight_layout(rect=(0, 0, 1, 0.94))
    save_figure(fig, ROOT_OUTPUT_DIR / filename, dpi=DPI, bbox_inches="tight")
    plt.close(fig)


def plot_pairwise(loaded):
    """
    Consecutive parameter pairs (as in their plots.m), points = 95 %
    credible region states, red star = posterior mean.
    """

    grades = list(loaded)
    pairs = list(zip(THESIS_ORDER[:-1], THESIS_ORDER[1:]))
    nc, nr = 3, int(np.ceil(len(pairs) / 3))

    fig = plt.figure(figsize=(4.2 * nc * len(grades) / 1.6, 2.6 * nr))
    outer = fig.add_gridspec(1, len(grades), wspace=0.18)

    for gi, g in enumerate(grades):
        inner = outer[gi].subgridspec(nr, nc, wspace=0.55, hspace=0.55)
        df = loaded[g]["credible"]
        mean = loaded[g]["sample"].mean()
        for k, (px, py) in enumerate(pairs):
            ax = fig.add_subplot(inner[k // nc, k % nc])
            ax.scatter(df[px], df[py], s=3, color="blue", alpha=0.45)
            ax.scatter([mean[px]], [mean[py]], marker="*", s=90, color="red", zorder=5)
            ax.set_xlabel(LABEL[px], fontsize=8)
            ax.set_ylabel(LABEL[py], fontsize=8)
            ax.tick_params(labelsize=6)
            ax.ticklabel_format(style="sci", scilimits=(-2, 3))
            ax.xaxis.get_offset_text().set_fontsize(6)
            ax.yaxis.get_offset_text().set_fontsize(6)
            ax.grid(alpha=0.25)
            if k == 1:
                ax.set_title(g, fontsize=11, fontweight="bold")

    save_figure(fig, ROOT_OUTPUT_DIR / "NIWA_pairwise_posterior_all_grades.png", dpi=DPI, bbox_inches="tight")
    plt.close(fig)


def plot_correlation(loaded):

    grades = list(loaded)
    fig, axs = plt.subplots(1, len(grades), figsize=(5.2 * len(grades), 5.0), squeeze=False)
    im = None

    for gi, g in enumerate(grades):
        ax = axs[0, gi]
        c = loaded[g]["sample"][THESIS_ORDER].corr().to_numpy()
        im = ax.imshow(c, cmap="RdBu_r", vmin=-1, vmax=1)
        for a in range(len(THESIS_ORDER)):
            for b in range(len(THESIS_ORDER)):
                ax.text(b, a, f"{c[a, b]:.2f}", ha="center", va="center", fontsize=6,
                        color="white" if abs(c[a, b]) > 0.6 else "black")
        lab = [LABEL[p] for p in THESIS_ORDER]
        ax.set_xticks(range(len(lab)))
        ax.set_yticks(range(len(lab)))
        ax.set_xticklabels(lab, fontsize=8)
        ax.set_yticklabels(lab, fontsize=8)
        ax.set_title(g, fontweight="bold")

    cb = fig.colorbar(im, ax=axs.ravel().tolist(), fraction=0.015, pad=0.02)
    cb.set_label("Pearson correlation")
    save_figure(fig, ROOT_OUTPUT_DIR / "NIWA_posterior_correlation_all_grades.png", dpi=DPI, bbox_inches="tight")
    plt.close(fig)


def make_figures():

    loaded = {g: x for g in GRADE_ORDER if (x := load_grade(g)) is not None}

    if not loaded:
        return

    plot_predictions(loaded)
    plot_rectangles(loaded, RATES, 3, "NIWA_rate_parameters_95CI_all_grades.png",
                    {p: r"Parameter value (h$^{-1}$)" for p in RATES})
    plot_rectangles(loaded, ["De0", "alpha_pH"], 2, "NIWA_De0_alphapH_95CI_all_grades.png",
                    {"De0": r"$D_{e0}$ (mm$^2$ h$^{-1}$)",
                     "alpha_pH": "pH units per free-product unit"})
    plot_pairwise(loaded)
    plot_correlation(loaded)


def write_master():

    outs = []
    for g in GRADE_ORDER:
        f = ROOT_OUTPUT_DIR / f"{g}_DONE.pkl"
        if f.exists():
            with open(f, "rb") as fh:
                outs.append(pickle.load(fh))

    if not outs:
        return

    xlsx = ROOT_OUTPUT_DIR / "MA_NIWA_vanMourik_50k_RESULTS.xlsx"

    try:
        with open(xlsx, "ab"):
            pass
    except OSError:
        xlsx = xlsx.with_name(xlsx.stem + time.strftime("_%Y%m%d_%H%M%S") + xlsx.suffix)
        print(f"WARNING: results workbook is open in another program; writing {xlsx.name}", flush=True)

    with pd.ExcelWriter(xlsx) as w:
        pd.concat([o["summary"] for o in outs]).to_excel(w, sheet_name="Parameters", index=False)
        pd.concat([o["diagnostics"] for o in outs]).to_excel(w, sheet_name="Diagnostics", index=False)
        pd.DataFrame(
            {"Setting": ["Chains", "Iterations per chain", "Thinning", "Burn-in",
                         "Sample size", "alpha", "Bounds", "sigma WL", "sigma Xc",
                         "sigma pH", "Reference"],
             "Value": [N_CHAINS, N_ITER, N_THIN, "first N_ITER/N_THIN saved states",
                       N_SAMPLE, ALPHA,
                       BOUNDS_MODE if BOUNDS_MODE != "relative" else f"PML/{DELTA:g} to PML*{DELTA:g}",
                       SIGMA["WL"], SIGMA["Xc"], SIGMA["pH"],
                       "van Mourik et al. (2014) PeerJ 2:e433"]}
        ).to_excel(w, sheet_name="Settings", index=False)


