def transform(x):
    """their transform.m"""
    return np.log10(x)


def backtransform(x):
    """their backtransform.m"""
    return 10.0 ** np.asarray(x, dtype=float)


# ================================================================
# NIWA MODEL (functionf.m / makeY.m equivalent)
# ================================================================

def enzyme_front_diffusion(E, phi, De0, E_surface):

    E_work = np.maximum(np.asarray(E, dtype=float), 0.0).copy()
    phi = np.clip(np.asarray(phi, dtype=float), 0.0, 1.0)

    # last cell = exposed surface, first cell = symmetry plane
    E_work[-1] = float(E_surface)

    phi_face = np.maximum(phi[:-1], phi[1:])
    Dface = De0 * np.power(phi_face, POROSITY_EXP_ENZYME)
    Jface = -Dface * (E_work[1:] - E_work[:-1]) / DX

    dEdt = np.zeros_like(E_work)
    dEdt[0] = -(Jface[0] - 0.0) / DX
    if N_GRID > 2:
        dEdt[1:-1] = -(Jface[1:] - Jface[:-1]) / DX
    dEdt[-1] = 0.0

    return dEdt, E_work


_SPARSITY = None


def jacobian_sparsity():

    global _SPARSITY

    if _SPARSITY is None:

        nf = 6
        n = nf * N_GRID + 1
        S = lil_matrix((n, n), dtype=int)

        for f in range(nf):
            for i in range(N_GRID):
                row = f * N_GRID + i
                for g in range(nf):
                    for j in (i - 1, i, i + 1):
                        if 0 <= j < N_GRID:
                            S[row, g * N_GRID + j] = 1
                S[row, n - 1] = 1

        S[n - 1, :] = 1
        _SPARSITY = S.tocsr()

    return _SPARSITY


def simulate_model(grade, pars, times_h):
    """
    NIWA: E + C -> Z_C (k1), Z_C -> E + D (kc), Z_C -> E + A (kr),
          E + A -> Z_A (k4), Z_A -> E + D (ka), D -> P (ke).
    Returns weight loss (%), crystallinity (%), bath pH.
    """

    X_FIXED = DATA[grade]["X_FIXED"]

    k1, kc, kr = pars["k1"], pars["kc"], pars["kr"]
    k4, ka, ke = pars["k4"], pars["ka"], pars["ke"]
    De0 = pars["De0"]

    times_h = np.asarray(times_h, dtype=float)

    def rhs(t, y):

        E, C, A, ZC, ZA, D = y[:-1].reshape(6, N_GRID)

        Epos = np.maximum(E, 0.0)
        Cpos = np.maximum(C, 0.0)
        Apos = np.maximum(A, 0.0)
        ZCpos = np.maximum(ZC, 0.0)
        ZApos = np.maximum(ZA, 0.0)
        Dpos = np.maximum(D, 0.0)

        solid = Cpos + Apos + ZCpos + ZApos + Dpos
        phi = np.clip(1.0 - solid / S0, 0.0, 1.0)

        diffE, Ereact = enzyme_front_diffusion(Epos, phi, De0, E_T)

        r1 = k1 * Ereact * Cpos
        rc = kc * ZCpos
        rr = kr * ZCpos
        r4 = k4 * Ereact * Apos
        ra = ka * ZApos
        re = ke * Dpos

        dE = diffE - r1 + rc + rr - r4 + ra
        dE[-1] = 0.0

        dP = float(np.mean(re)) / S0

        return np.concatenate(
            [
                np.vstack(
                    [dE, -r1, rr - r4, r1 - rc - rr, r4 - ra, rc + ra - re]
                ).reshape(-1),
                np.array([dP]),
            ]
        )

    y0 = np.concatenate(
        [
            np.vstack(
                [
                    np.full(N_GRID, E_INIT),
                    np.full(N_GRID, X_FIXED * S0),
                    np.full(N_GRID, (1.0 - X_FIXED) * S0),
                    np.zeros(N_GRID),
                    np.zeros(N_GRID),
                    np.zeros(N_GRID),
                ]
            ).reshape(-1),
            np.array([0.0]),
        ]
    )

    sol = solve_ivp(
        fun=rhs,
        t_span=(float(times_h[0]), float(times_h[-1])),
        y0=y0,
        t_eval=times_h,
        method="BDF",
        rtol=RTOL,
        atol=ATOL,
        max_step=MAX_STEP,
        jac_sparsity=jacobian_sparsity(),
    )

    if not sol.success or not np.all(np.isfinite(sol.y)):
        raise RuntimeError("PDE solver failed: " + str(sol.message))

    n_t = len(sol.t)

    Yt = np.maximum(sol.y[:-1, :].T.reshape(n_t, 6, N_GRID), 0.0)

    C, A, ZC, ZA, D = Yt[:, 1], Yt[:, 2], Yt[:, 3], Yt[:, 4], Yt[:, 5]
    P = np.maximum(sol.y[-1, :], 0.0)

    S = C + A + ZC + ZA + D
    phi = np.clip(1.0 - S / S0, 0.0, 1.0)

    WL = 100.0 * np.mean(phi, axis=1)
    Xc = 100.0 * np.mean(C + ZC, axis=1) / np.maximum(np.mean(S, axis=1), 1.0e-14)
    pH = PH0 - pars["alpha_pH"] * P

    return WL, Xc, pH


def theta_to_pars(theta_log10):
    return dict(zip(NAMES, backtransform(theta_log10)))


# ================================================================
# LOG-POSTERIOR (logposterior.m)
#   logpost = logprior + loglikelihood
#   loglikelihood = -0.5 * sum ((y(theta) - y_data) / sigma)^2
#   logprior = constant inside [lb, ub], -inf outside
# ================================================================

def make_logposterior(grade, lb, ub):

    d = DATA[grade]

    def logposterior(theta):

        theta = np.asarray(theta, dtype=float)

        if not (np.all(theta > lb) and np.all(theta < ub)):
            return -np.inf

        try:
            WL, Xc, pH = simulate_model(grade, theta_to_pars(theta), T_MAIN)
        except Exception:
            return -np.inf

        eps = np.concatenate(
            [
                (WL - d["wl_obs"]) / SIGMA["WL"],
                (Xc - d["xc_obs"]) / SIGMA["Xc"],
                (pH - d["ph_obs"]) / SIGMA["pH"],
            ]
        )

        if not np.all(np.isfinite(eps)):
            return -np.inf

        return 1.0 - 0.5 * float(np.sum(eps ** 2))

    return logposterior


def search_domain(grade):

    a0 = transform(np.array([THETA_PML[grade][p] for p in NAMES]))

    if BOUNDS_MODE == "relative":
        lb = a0 - np.log10(DELTA)
        ub = a0 + np.log10(DELTA)
    else:
        lb = np.full(len(NAMES), np.log10(FIT_LOWER))
        ub = np.full(len(NAMES), np.log10(FIT_UPPER))

    return a0, lb, ub


def inside(x, lb, ub):
    """Reflect a state into the open search domain (needed because the
    global theta_PML has rates on the upper bound)."""

    x = np.asarray(x, dtype=float)
    x = np.where(x > ub, 2.0 * ub - x, x)
    x = np.where(x < lb, 2.0 * lb - x, x)

    return np.clip(x, lb + 1.0e-9, ub - 1.0e-9)


# ================================================================
# GELMAN-RUBIN R (Gelman.m)
# ================================================================

def gelman_R(seq):
    """seq: (n iterations, d parameters, m chains)"""

    n, d, m = seq.shape

    if n < 10:
        return -2.0 * np.ones(d)

    meanSeq = seq.mean(axis=0).T                 # m x d
    B = n * meanSeq.var(axis=0, ddof=1)
    W = np.mean([seq[:, :, k].var(axis=0, ddof=1) for k in range(m)], axis=0)
    sigma2 = ((n - 1) / n) * W + B / n

    return np.sqrt((m + 1) / m * sigma2 / W - (n - 1) / (m * n))


# ================================================================
# DE-MCz (DEMCz.m + Makedistribution.m), with checkpoints
# ================================================================

def run_demcz(grade, log=print):

    rng = np.random.default_rng(SEED + 1000 * GRADE_ORDER.index(grade))

    a0, lb, ub = search_domain(grade)
    a0 = np.clip(a0, lb + EDGE_MARGIN, ub - EDGE_MARGIN)
    logpost = make_logposterior(grade, lb, ub)

    d = len(NAMES)
    m = N_CHAINS
    gamma = 2.38 / np.sqrt(2 * d)

    case_dir = ROOT_OUTPUT_DIR / grade
    case_dir.mkdir(parents=True, exist_ok=True)
    ck_path = case_dir / f"{grade}_DEMCz_checkpoint.pkl"

    if ck_path.exists():

        with open(ck_path, "rb") as fh:
            ck = pickle.load(fh)

        states, cur_lp, Z, Zlp = ck["states"], ck["cur_lp"], ck["Z"], ck["Zlp"]
        seq, R_hist = ck["seq"], ck["R_hist"]
        accept, i_start = ck["accept"], ck["iteration"] + 1
        mZ0 = ck["mZ0"]
        rng.bit_generator.state = ck["rng_state"]

        log(f"Resuming {grade} at iteration {i_start}")

    else:

        # initstate(j,:) = a0 + 0.001 randn
        states = np.array(
            [inside(a0 + INIT_SD * rng.standard_normal(d), lb, ub) for _ in range(m)]
        )

        # Z = initstate(1,:) .* (1 + 0.001 randn), 10*n + 1 rows
        Z = np.array(
            [inside(states[0] * (1.0 + INIT_SD * rng.standard_normal(d)), lb, ub)
             for _ in range(10 * d + 1)]
        )
        mZ0 = Z.shape[0]
        Zlp = np.full(mZ0, np.nan)

        cur_lp = np.array([logpost(s) for s in states])

        seq = np.zeros((0, d, m))
        R_hist = []
        accept = 0
        i_start = 1

        log(f"{grade}: initial log-posterior of chains {np.round(cur_lp, 3)}")

    seq_list = [seq] if seq.size else []
    t0 = time.time()

    for i in range(i_start, N_ITER + 1):

        for j in range(m):

            mZ = Z.shape[0] - m          # exclude the m most recent rows
            n1 = int(np.ceil(rng.random() * mZ)) - 1
            n2 = int(np.ceil(rng.random() * (mZ - 1))) - 1
            n1 = max(n1, 0)
            n2 = max(n2, 0)
            if n2 >= n1:
                n2 += 1

            proposal = (
                states[j]
                + gamma * (Z[n1] - Z[n2])
                + JITTER * rng.standard_normal(d)
            )

            prop_lp = logpost(proposal)

            if np.log(rng.random()) < prop_lp - cur_lp[j]:
                states[j] = proposal
                cur_lp[j] = prop_lp
                accept += 1

        seq_list.append(states.T[None, :, :].copy())

        if i % N_THIN == 0:
            Z = np.vstack([Z, states])
            Zlp = np.concatenate([Zlp, cur_lp])

        if i % GELMAN_EVERY == 0 or i == N_ITER:

            seq = np.concatenate(seq_list, axis=0)
            seq_list = [seq]

            R = gelman_R(seq[int(round(i / 2)) - 1: i])
            R_hist.append([i] + list(R))

            el = time.time() - t0
            log(
                f"Iteration {i:6d}/{N_ITER} | accept = "
                f"{accept / (i * m):.3f} | max R = {np.nanmax(R):.3f} | "
                f"best logpost = {np.nanmax(Zlp):.3f} | {el:.0f} s this session"
            )

            tmp = ck_path.with_suffix(".tmp")
            with open(tmp, "wb") as fh:
                pickle.dump(
                    {
                        "states": states, "cur_lp": cur_lp, "Z": Z, "Zlp": Zlp,
                        "seq": seq, "R_hist": R_hist, "accept": accept,
                        "iteration": i, "mZ0": mZ0,
                        "rng_state": rng.bit_generator.state,
                    },
                    fh,
                )
            tmp.replace(ck_path)

    # saved states = Z without the initial archive
    saved = Z[mZ0:]
    saved_lp = Zlp[mZ0:]

    # burn-in: bi = nit / nthin rows (Makedistribution.m)
    bi = N_ITER // N_THIN
    post = saved[bi:]
    post_lp = saved_lp[bi:]

    R_df = pd.DataFrame(R_hist, columns=["iteration"] + NAMES)

    return {
        "post": post,
        "post_lp": post_lp,
        "R": R_df,
        "accept_rate": accept / (N_ITER * m),
        "a0": a0,
        "lb": lb,
        "ub": ub,
        "seq": seq,
    }


# ================================================================
# PART II: PREDICTION ENVELOPE (makeY.m, plots.m)
# ================================================================

def predict(grade, theta, t, perturb=None):

    pars = theta_to_pars(theta)

    if perturb is not None:
        name, factor = perturb
        pars[name] = pars[name] * factor

    WL, Xc, pH = simulate_model(grade, pars, t)

    Y = np.column_stack([WL, Xc, pH])

    return np.clip(Y, Y_FLOOR, Y_CEIL)        # makeY.m


def predict_sample(grade, sample, t):
    """Model predictions for every sampled parameter vector."""

    preds = np.full((sample.shape[0], len(t), 3), np.nan)
    failed = 0

    for k, theta in enumerate(sample):

        try:
            preds[k] = predict(grade, theta, t)
        except Exception:
            failed += 1

    return preds, failed


def envelope(values):
    """
    plots.m: at each time point sort the N predictions, discard the
    round((1-alpha) N/2) largest and (that + 1) smallest, min-max of rest.
    """

    v = values[np.all(np.isfinite(values), axis=1)]
    N = v.shape[0]
    ind2 = int(round((1 - ALPHA) * N / 2))

    s = -np.sort(-v, axis=0)              # descending
    kept = s[ind2: N - (ind2 + 1)]

    return kept.min(axis=0), kept.max(axis=0), v.mean(axis=0)


# ================================================================
# ONE GRADE
# ================================================================

def analyse_grade(grade):

    case_dir = ROOT_OUTPUT_DIR / grade
    case_dir.mkdir(parents=True, exist_ok=True)

    log_path = ROOT_OUTPUT_DIR / f"LOG_{grade}.txt"

    def log(msg):
        with open(log_path, "a", encoding="utf-8") as fh:
            fh.write(msg + "\n")
        print(msg, flush=True)

    warnings.filterwarnings("ignore", category=RuntimeWarning)

    # check theta_PML reproduces the deterministic fit
    a0 = transform(np.array([THETA_PML[grade][p] for p in NAMES]))
    WL, Xc, pH = simulate_model(grade, theta_to_pars(a0), T_MAIN)
    d = DATA[grade]
    sse = float(
        np.sum((WL - d["wl_obs"]) ** 2)
        + np.sum((Xc - d["xc_obs"]) ** 2)
        + np.sum((pH - d["ph_obs"]) ** 2)
    )
    log(f"{grade}: SSE at theta_PML = {sse:.6f} (reference {REFERENCE_SSE[grade]:.6f})")

    # ---------------- PART I ----------------
    res = run_demcz(grade, log)

    post, post_lp = res["post"], res["post_lp"]

    rng = np.random.default_rng(SEED + 77 + GRADE_ORDER.index(grade))

    # random draws with replacement (Main.m: ceil(rand*size(states,1)))
    idx = rng.integers(0, post.shape[0], size=N_SAMPLE)
    sample = post[idx]
    sample_lp = post_lp[idx]

    sample_lin = backtransform(sample)

    pd.DataFrame(sample_lin, columns=NAMES).to_csv(
        case_dir / f"{grade}_NIWA_sample_{N_SAMPLE}.csv", index=False
    )
    pd.DataFrame(backtransform(post), columns=NAMES).assign(
        log_posterior=post_lp
    ).to_csv(case_dir / f"{grade}_NIWA_all_post_burnin_states.csv", index=False)
    res["R"].to_csv(case_dir / f"{grade}_NIWA_Gelman_R.csv", index=False)

    # parameter summary from the sample
    rows = []
    for j, p in enumerate(NAMES):
        v = sample_lin[:, j]
        rows.append(
            {
                "Polymer": grade,
                "Parameter": p,
                "theta_PML": THETA_PML[grade][p],
                "Posterior_mean": float(np.mean(v)),
                "Posterior_median": float(np.median(v)),
                "CI_2.5": float(np.percentile(v, 2.5)),
                "CI_97.5": float(np.percentile(v, 97.5)),
                "Final_Gelman_R": float(res["R"][p].iloc[-1]),
            }
        )
    summary = pd.DataFrame(rows)
    summary.to_csv(case_dir / f"{grade}_NIWA_parameter_summary.csv", index=False)

    # 95 % credible region (plots.m): drop the 5 % least probable states
    ind = int(round((1 - ALPHA) * N_SAMPLE))
    order = np.argsort(sample_lp)              # ascending log-posterior
    credible = sample_lin[order[ind:]]
    pd.DataFrame(credible, columns=NAMES).to_csv(
        case_dir / f"{grade}_NIWA_credible_region_states.csv", index=False
    )

    # ---------------- PART II ----------------
    t_pred = np.linspace(0.0, T_FINAL, N_PRED_TIME)

    log(f"{grade}: computing the prediction envelope for {N_SAMPLE} draws")
    preds, failed = predict_sample(grade, sample, t_pred)
    log(f"{grade}: failed integrations: {failed}")

    band = {"time_h": t_pred}
    for k, key in enumerate(["WL", "Xc", "pH"]):
        lo, hi, mean = envelope(preds[:, :, k])
        band[f"{key}_lower"] = lo
        band[f"{key}_upper"] = hi
        band[f"{key}_mean"] = mean
    pd.DataFrame(band).to_csv(case_dir / f"{grade}_NIWA_envelope.csv", index=False)

    out = {
        "summary": summary,
        "diagnostics": pd.DataFrame(
            [{
                "Polymer": grade,
                "Chains": N_CHAINS,
                "Iterations_per_chain": N_ITER,
                "Thinning": N_THIN,
                "Post_burnin_states": post.shape[0],
                "Sample_size": N_SAMPLE,
                "Acceptance_rate": res["accept_rate"],
                "Max_final_Gelman_R": float(res["R"][NAMES].iloc[-1].max()),
                "Bounds_mode": BOUNDS_MODE,
                "sigma_WL": SIGMA["WL"], "sigma_Xc": SIGMA["Xc"], "sigma_pH": SIGMA["pH"],
                "Failed_integrations": failed,
            }]
        ),
    }

    with open(ROOT_OUTPUT_DIR / f"{grade}_DONE.pkl", "wb") as fh:
        pickle.dump(out, fh)

    plot_grade_diagnostics(grade, res)

    log(f"{grade}: finished")

    return out


