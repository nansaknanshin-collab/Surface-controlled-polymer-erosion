    observed_fit.to_csv(
        grade_dir / f"{polymer_grade}_{model_variant}_observed_vs_fit.csv",
        index=False,
    )

    # =====================================================
    # PLOTS
    # =====================================================

    def style_axis(ax, integer_y=True):
