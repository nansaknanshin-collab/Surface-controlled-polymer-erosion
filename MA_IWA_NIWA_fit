        }
    )

    if has_inhibition:
        dense["ZI_mean"] = fields["ZI_mean"]
        dense["active_local_fraction"] = fields["active_local_fraction"]

    dense.to_csv(
        grade_dir / f"{polymer_grade}_{model_variant}_dense_timeseries.csv",
        index=False,
    )

    observed_fit = pd.DataFrame(
        {
            "time_h": t_all_h,
            "WL_obs_pct": np.interp(t_all_h, t_W_h, WL_obs_pct),
            "WL_fit_pct": np.interp(t_all_h, t_W_h, WL_fit),
            "Xc_obs_pct": np.interp(t_all_h, t_X_h, Xc_obs_pct),
            "Xc_fit_pct": np.interp(t_all_h, t_X_h, Xc_fit),
            "pH_obs": np.interp(t_all_h, t_PH_h, PH_obs),
            "pH_fit": np.interp(t_all_h, t_PH_h, PH_fit),
        }
