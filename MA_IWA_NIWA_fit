def build_model_comparison(results_df):
    if results_df.empty:
        return pd.DataFrame()

    rows = []
    for grade in GRADE_ORDER:
        g = results_df.loc[results_df["Polymer"] == grade].copy()
        if g.empty:
            continue

        g = g.sort_values("AICc_raw_joint_WL_Xc_pH", na_position="last").reset_index(drop=True)
        finite = np.isfinite(g["AICc_raw_joint_WL_Xc_pH"].to_numpy(dtype=float))

        if np.any(finite):
            min_aicc = float(np.nanmin(g.loc[finite, "AICc_raw_joint_WL_Xc_pH"]))
            g["Delta_AICc"] = g["AICc_raw_joint_WL_Xc_pH"] - min_aicc
            rel = np.exp(-0.5 * g["Delta_AICc"].to_numpy(dtype=float))
            rel[~np.isfinite(rel)] = 0.0
            denom = float(np.sum(rel))
            g["Akaike_weight"] = rel / denom if denom > 0.0 else np.nan
        else:
            g["Delta_AICc"] = np.nan
            g["Akaike_weight"] = np.nan

        g["AICc_rank"] = np.arange(1, len(g) + 1)
        rows.append(g)

    if not rows:
        return pd.DataFrame()
    return pd.concat(rows, ignore_index=True)


def degraded_material_fraction(D, remaining_solid, dx):
    """Integral ratio f_D on the uniform cell-centred finite-volume grid.

    remaining_solid = C + A + ZC + ZA + D. The pore volume and free product
    are excluded. f_D is dimensionless and undefined if no solid remains.
    """
    D = np.asarray(D, dtype=float)
    remaining_solid = np.asarray(remaining_solid, dtype=float)
    if D.shape != remaining_solid.shape or D.ndim != 2:
        raise ValueError('D and remaining_solid must have matching (time, cell) shapes.')
    if not np.isfinite(dx) or dx <= 0:
        raise ValueError('dx must be positive and finite.')
    D_integral = np.sum(D, axis=1) * dx
    solid_integral = np.sum(remaining_solid, axis=1) * dx
    fraction = np.full(D_integral.shape, np.nan, dtype=float)
    np.divide(D_integral, solid_integral, out=fraction, where=solid_integral > 0)
    return fraction, D_integral, solid_integral


def fraction_from_dense(dense):
    """Read new integral exports or the existing equivalent fraction column."""
    if {'D_integral', 'remaining_solid_integral'}.issubset(dense.columns):
        numerator = dense['D_integral'].to_numpy(dtype=float)
        denominator = dense['remaining_solid_integral'].to_numpy(dtype=float)
        values = np.full(numerator.shape, np.nan, dtype=float)
        np.divide(numerator, denominator, out=values, where=denominator > 0)
        return values
    if 'f_D' in dense.columns:
        return dense['f_D'].to_numpy(dtype=float)
    if 'retained_D_fraction' in dense.columns:
        # On this equal-width grid, mean(D)/mean(S) equals sum(D dx)/sum(S dx).
        return dense['retained_D_fraction'].to_numpy(dtype=float)
    raise ValueError('Saved dense CSV has no degraded fraction or spatial integrals. '
                     'Run the updated fitting script to export them.')


def create_combined_degraded_fraction_plots(results_df):
    """Save 100*f_D percentage comparisons per grade and a three-grade panel, without refitting."""
    curves = {}
    rows = []
    for grade in GRADE_ORDER:
        curves[grade] = {}
        for model in RUN_VARIANTS:
            if results_df.loc[(results_df['Polymer'] == grade) &
                              (results_df['Model'] == model)].empty:
                continue
            file = ROOT_OUTPUT_DIR / model / grade / f'{grade}_{model}_dense_timeseries.csv'
            if not file.exists():
                print(f'WARNING: missing f_D input: {file}')
                continue
            dense = pd.read_csv(file)
            try:
                fraction = fraction_from_dense(dense)
            except ValueError as exc:
                print(f'WARNING: {grade} {model}: {exc}')
                continue
            times = dense['time_h'].to_numpy(dtype=float)
            curves[grade][model] = (times, fraction)
            rows.append(pd.DataFrame({'Polymer': grade, 'Model': model,
                                      'time_h': times, 'f_D': fraction,
                                      'f_D_pct': 100.0 * fraction}))
            undefined = np.count_nonzero(~np.isfinite(fraction))
            if undefined:
                print(f'{grade} {model}: {undefined} undefined f_D values are omitted from the curve.')

    def draw(ax, grade):
        for model in RUN_VARIANTS:
            if model in curves[grade]:
                times, fraction = curves[grade][model]
                # Keep f_D as a ratio in calculations; convert once for percentage display.
                ax.plot(times, 100.0 * fraction, label=model, **MODEL_STYLES[model])
        ax.set_xlabel('Time (h)', fontsize=18, fontweight='bold')
        ax.set_ylabel('Degraded fraction (%)', fontsize=18, fontweight='bold')
        ax.set_title(grade, fontsize=20, fontweight='bold')
        ax.set_xlim(0.0, 20.0)
        # Autoscaling retains small nonzero percentages; no fixed 0-to-100 display.
        ax.tick_params(axis='both', labelsize=16)
        for label in ax.get_xticklabels() + ax.get_yticklabels():
            label.set_fontweight('bold')
        ax.xaxis.set_major_locator(MaxNLocator(integer=True))
        ax.grid(alpha=0.3)
        if curves[grade]:
            ax.legend(prop={'size': 14, 'weight': 'bold'}, frameon=True)

    for grade in GRADE_ORDER:
        if not curves[grade]:
            print(f'WARNING: no f_D curves available for {grade}; figure not generated.')
            continue
        missing = [m for m in RUN_VARIANTS if m not in curves[grade]]
        if missing:
            print(f'WARNING: {grade} f_D comparison is incomplete: missing {missing}.')
        fig, ax = plt.subplots(figsize=(8, 5.5))
        draw(ax, grade)
        fig.tight_layout()
        for suffix in ('png', 'pdf'):
            safe_figure_savefig(fig, COMBINED_PLOT_DIR / f'{grade}_fD_IWA_NIWA_comparison.{suffix}',
                               **({'dpi': DPI, 'bbox_inches': 'tight'} if suffix == 'png'
                                  else {'bbox_inches': 'tight'}))
        plt.close(fig)
        combined = None
        for model, (times, fraction) in curves[grade].items():
            frame = pd.DataFrame({'time_h': times, f'f_D_{model}': fraction,
                                  f'f_D_pct_{model}': 100.0 * fraction})
            combined = frame if combined is None else pd.merge(combined, frame, on='time_h', how='outer')
        safe_dataframe_to_csv(combined.sort_values('time_h'),
                              COMBINED_PLOT_DIR / f'{grade}_fD_IWA_NIWA_curves.csv', index=False)
        print(f'{grade}: combined degraded fraction plot saved.')

    if rows:
        safe_dataframe_to_csv(pd.concat(rows, ignore_index=True),
                              COMBINED_PLOT_DIR / 'IWA_NIWA_fD_all_grades.csv', index=False)
        fig, axes = plt.subplots(1, len(GRADE_ORDER), figsize=(18, 5.5), squeeze=False)
        for ax, grade in zip(axes.ravel(), GRADE_ORDER):
            draw(ax, grade)
            if not curves[grade]:
                ax.text(.5, .5, 'No saved results', transform=ax.transAxes, ha='center')
        fig.tight_layout()
        for suffix in ('png', 'pdf'):
            # Wide composite: cap raster DPI to avoid an excessively large PNG.
            safe_figure_savefig(fig, COMBINED_PLOT_DIR / f'IWA_NIWA_fD_all_grades.{suffix}',
                               **({'dpi': min(DPI, 300), 'bbox_inches': 'tight'} if suffix == 'png'
                                  else {'bbox_inches': 'tight'}))
        plt.close(fig)


def plot_saved_comparisons():
    """Redraw comparison figures from saved dense CSVs; no optimization/PDE run."""
    rows = []
    for grade in GRADE_ORDER:
        for model in RUN_VARIANTS:
            file = ROOT_OUTPUT_DIR / model / grade / f'{grade}_{model}_dense_timeseries.csv'
            if file.exists():
                rows.append({'Polymer': grade, 'Model': model})
    if not rows:
        raise FileNotFoundError(f'No saved dense CSVs found in {ROOT_OUTPUT_DIR}. Run fitting first.')
    COMBINED_PLOT_DIR.mkdir(parents=True, exist_ok=True)
    create_combined_model_plots(pd.DataFrame(rows))


# =========================================================
# COMBINED IWA–NIWA PLOTS FOR EACH EXPERIMENTAL RESPONSE
# =========================================================

def create_combined_model_plots(results_df):
    """
    For each PCL grade, overlay the experimental data with all successful
    model variants on the same axes.

    Files generated per grade:
      1) weight-loss comparison
      2) crystallinity comparison
      3) bath-pH comparison
      4) degraded fraction f_D comparison and CSV
      5) combined model-curves CSV
    Also saves a three-grade f_D percentage panel and all-grade CSV.
    CSVs retain the raw f_D ratio and add explicitly named f_D_pct columns.

    Each figure is saved as SVG, pixel-budgeted PNG, and vector PDF.
    """

    if results_df.empty:
        print("No fitted results available for combined plots.")
        return

    print("\n" + "=" * 104)
    create_combined_degraded_fraction_plots(results_df)
    print("CREATING COMBINED IWA–NIWA COMPARISON PLOTS")
    print("=" * 104)

    for grade in GRADE_ORDER:
        data = ALL_POLYMER_DATA[grade]

        t_W = np.asarray(data["t_wl"], dtype=float)
        WL_obs = 100.0 * np.asarray(data["wl_obs"], dtype=float)

        t_X = np.asarray(data["t_xc"], dtype=float)
        Xc_obs = 100.0 * np.asarray(data["xc_obs"], dtype=float)

        t_PH = np.asarray(data["t_ph"], dtype=float)
        PH_obs = np.asarray(data["ph_obs"], dtype=float)

        grade_models = results_df.loc[
            results_df["Polymer"] == grade, "Model"
        ].astype(str).tolist()
        grade_models = [m for m in RUN_VARIANTS if m in grade_models]

        model_curves = {}
        combined_df = None

        for model_variant in grade_models:
            dense_file = (
                ROOT_OUTPUT_DIR
                / model_variant
                / grade
                / f"{grade}_{model_variant}_dense_timeseries.csv"
            )

            if not dense_file.exists():
                print(
                    f"  WARNING: missing dense file for {grade} {model_variant}: "
                    f"{dense_file}"
                )
                continue

            dense = pd.read_csv(dense_file)

            required = {"time_h", "WL_model_pct", "Xc_model_pct", "pH_model"}
            missing = required.difference(dense.columns)
            if missing:
                print(
                    f"  WARNING: {dense_file.name} missing columns "
                    f"{sorted(missing)}; skipping."
                )
                continue

            model_curves[model_variant] = dense

            curve = dense[
                ["time_h", "WL_model_pct", "Xc_model_pct", "pH_model"]
            ].copy()
            curve = curve.rename(
                columns={
                    "WL_model_pct": f"WL_{model_variant}_pct",
                    "Xc_model_pct": f"Xc_{model_variant}_pct",
                    "pH_model": f"pH_{model_variant}",
                }
            )

            if combined_df is None:
                combined_df = curve
            else:
                combined_df = pd.merge(
                    combined_df, curve, on="time_h", how="outer"
                )

        if not model_curves:
            print(f"  {grade}: no model curves found; combined plots skipped.")
            continue

        if combined_df is not None:
            combined_df = combined_df.sort_values("time_h").reset_index(drop=True)
            safe_dataframe_to_csv(
                combined_df,
                COMBINED_PLOT_DIR / f"{grade}_IWA_NIWA_combined_curves.csv",
                index=False,
            )

        # -------------------------------------------------
        # Weight loss
        # -------------------------------------------------
        fig, ax = plt.subplots(figsize=(8, 5.5))
        ax.plot(
            t_W,
            WL_obs,
            "ko",
            ms=DATA_MARKERSIZE,
            label=f"{grade} data",
            zorder=10,
        )

        for model_variant in RUN_VARIANTS:
            if model_variant not in model_curves:
                continue
            d = model_curves[model_variant]
            ax.plot(
                d["time_h"],
                d["WL_model_pct"],
                label=f"{grade} {model_variant}",
                **MODEL_STYLES[model_variant],
            )

        ax.set_xlabel("Time (h)", fontsize=18)
        ax.set_ylabel("Weight loss (%)", fontsize=18)
        ax.set_xlim(0.0, 20.0)
        ax.set_ylim(0.0, 100.0)
        ax.xaxis.set_major_locator(MaxNLocator(integer=True))
        ax.yaxis.set_major_locator(MaxNLocator(integer=True))
        ax.tick_params(axis="both", labelsize=16)
        ax.grid(alpha=0.3)
        ax.legend(fontsize=12, frameon=True)
        plt.tight_layout()

        png = COMBINED_PLOT_DIR / f"{grade}_WL_IWA_NIWA_comparison.png"
        pdf = COMBINED_PLOT_DIR / f"{grade}_WL_IWA_NIWA_comparison.pdf"
        safe_figure_savefig(fig, png, dpi=DPI, bbox_inches="tight")
        safe_figure_savefig(fig, pdf, bbox_inches="tight")
        plt.close(fig)

        # -------------------------------------------------
        # Remaining crystallinity
        # -------------------------------------------------
        fig, ax = plt.subplots(figsize=(8, 5.5))
        ax.plot(
            t_X,
            Xc_obs,
            "ks",
            ms=DATA_MARKERSIZE,
            label=f"{grade} data",
            zorder=10,
        )

        for model_variant in RUN_VARIANTS:
            if model_variant not in model_curves:
                continue
            d = model_curves[model_variant]
            ax.plot(
                d["time_h"],
                d["Xc_model_pct"],
                label=f"{grade} {model_variant}",
                **MODEL_STYLES[model_variant],
            )

        ax.set_xlabel("Time (h)", fontsize=18)
        ax.set_ylabel("Remaining crystallinity (%)", fontsize=18)
        ax.set_xlim(0.0, 20.0)
        ax.set_ylim(0.0, 70.0)
        ax.xaxis.set_major_locator(MaxNLocator(integer=True))
        ax.yaxis.set_major_locator(MaxNLocator(integer=True))
        ax.tick_params(axis="both", labelsize=16)
        ax.grid(alpha=0.3)
        ax.legend(fontsize=12, frameon=True)
        plt.tight_layout()

        png = COMBINED_PLOT_DIR / f"{grade}_Xc_IWA_NIWA_comparison.png"
        pdf = COMBINED_PLOT_DIR / f"{grade}_Xc_IWA_NIWA_comparison.pdf"
        safe_figure_savefig(fig, png, dpi=DPI, bbox_inches="tight")
        safe_figure_savefig(fig, pdf, bbox_inches="tight")
        plt.close(fig)

        # -------------------------------------------------
        # Bath pH
        # -------------------------------------------------
        fig, ax = plt.subplots(figsize=(8, 5.5))
        ax.plot(
            t_PH,
            PH_obs,
            "kd",
            ms=DATA_MARKERSIZE,
            label=f"{grade} data",
            zorder=10,
        )

        for model_variant in RUN_VARIANTS:
            if model_variant not in model_curves:
                continue
            d = model_curves[model_variant]
            ax.plot(
                d["time_h"],
                d["pH_model"],
                label=f"{grade} {model_variant}",
                **MODEL_STYLES[model_variant],
            )

        ax.set_xlabel("Time (h)", fontsize=18)
        ax.set_ylabel("Bath pH", fontsize=18)
        ax.set_xlim(0.0, 20.0)
        ax.set_ylim(3.8, 7.4)
        ax.xaxis.set_major_locator(MaxNLocator(integer=True))
        ax.yaxis.set_major_locator(MaxNLocator(integer=True))
        ax.tick_params(axis="both", labelsize=16)
        ax.grid(alpha=0.3)
        ax.legend(fontsize=12, frameon=True)
        plt.tight_layout()

        png = COMBINED_PLOT_DIR / f"{grade}_pH_IWA_NIWA_comparison.png"
        pdf = COMBINED_PLOT_DIR / f"{grade}_pH_IWA_NIWA_comparison.pdf"
        safe_figure_savefig(fig, png, dpi=DPI, bbox_inches="tight")
        safe_figure_savefig(fig, pdf, bbox_inches="tight")
        plt.close(fig)

        print(
            f"  {grade}: combined WL, Xc and pH comparison plots saved "
            f"for {', '.join(model_curves.keys())}."
        )

