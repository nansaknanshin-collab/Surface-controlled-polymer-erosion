    if has_inhibition:
        result["Final_ZI_mean"] = float(fields["ZI_mean"][-1])
        result["Final_active_local_fraction"] = float(
            fields["active_local_fraction"][-1]
        )

    for name in param_names:
        result[name] = pars_hat[name]

    return result

