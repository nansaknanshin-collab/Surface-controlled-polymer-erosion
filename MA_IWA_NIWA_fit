def fit_polymer_grade(model_variant, polymer_grade, data):
    model_variant = canonical_variant(model_variant)
    cfg = VARIANT_CONFIG[model_variant]
    has_inhibition = bool(cfg["has_inhibition"])
    has_amorphisation = bool(cfg["has_amorphisation"])
    param_names = parameter_names_for_variant(model_variant)

    model_dir = ROOT_OUTPUT_DIR / model_variant
    grade_dir = model_dir / polymer_grade
    grade_dir.mkdir(parents=True, exist_ok=True)

    X_FIXED = float(data["X_FIXED"])
    C0_POLY = X_FIXED * S0
    A0_POLY = (1.0 - X_FIXED) * S0

    t_X_h = np.asarray(data["t_xc"], dtype=float)
    t_W_h = np.asarray(data["t_wl"], dtype=float)
    t_PH_h = np.asarray(data["t_ph"], dtype=float)

    Xc_obs_pct = 100.0 * np.asarray(data["xc_obs"], dtype=float)
    WL_obs_pct = 100.0 * np.asarray(data["wl_obs"], dtype=float)
    PH_obs = np.asarray(data["ph_obs"], dtype=float)

    t_all_h = np.unique(np.concatenate([t_W_h, t_X_h, t_PH_h]))

    P0_OPT = np.array([P0_MAP[name] for name in param_names], dtype=float)
    lb_phys, ub_phys, theta_lb, theta_ub = parameter_bounds_for_variant(param_names)
    P0_OPT = np.clip(P0_OPT, lb_phys, ub_phys)
    THETA0_BASE = np.log(P0_OPT)

    def rhs_pde(t, y, pars):
        k1 = pars["k1"]
        kc = pars["kc"]
        kr = pars["kr"] if has_amorphisation else 0.0
        k4 = pars["k4"]
        ka = pars["ka"]
        ke = pars["ke"]
        ki = pars["ki"] if has_inhibition else 0.0
        De0 = pars["De0"]

        if has_inhibition:
            Y = y[:-1].reshape(7, N_GRID)
            P = float(y[-1])
            E, ZI, C, A, ZC, ZA, D = Y
        else:
            Y = y[:-1].reshape(6, N_GRID)
            P = float(y[-1])
            E, C, A, ZC, ZA, D = Y

        Epos = np.maximum(E, 0.0)
        Cpos = np.maximum(C, 0.0)
        Apos = np.maximum(A, 0.0)
        ZCpos = np.maximum(ZC, 0.0)
        ZApos = np.maximum(ZA, 0.0)
        Dpos = np.maximum(D, 0.0)
        Ppos = max(P, 0.0)

        if has_inhibition:
            ZIpos = np.maximum(ZI, 0.0)

        solid = Cpos + Apos + ZCpos + ZApos + Dpos
        phi = np.clip(1.0 - solid / S0, 0.0, 1.0)

        diffE, Ereact = enzyme_front_diffusion(Epos, phi, De0, E_T)

        r1 = k1 * Ereact * Cpos
        rc = kc * ZCpos
        rr = kr * ZCpos if has_amorphisation else np.zeros_like(ZCpos)
        r4 = k4 * Ereact * Apos
        ra = ka * ZApos
        re = ke * Dpos

        if has_inhibition:
            rinh = ki * Ereact * Ppos
        else:
            rinh = np.zeros_like(Ereact)

        dC = -r1
        dZC = r1 - rc - rr
        dA = -r4 + rr
        dZA = r4 - ra
        dD = rc + ra - re

        dE = diffE - r1 + rc + rr - r4 + ra - rinh
        dE[-1] = 0.0

        # Manuscript product balance.
        R_rel = float(np.mean(re)) / S0
        R_inh = float(np.mean(rinh)) if has_inhibition else 0.0
        dP = R_rel - R_inh

        if has_inhibition:
            # ZI is a local inhibited-enzyme state; it has NO diffusion equation.
            dZI = rinh
            dy_fields = np.vstack(
                [dE, dZI, dC, dA, dZC, dZA, dD]
            ).reshape(-1)
        else:
            dy_fields = np.vstack(
                [dE, dC, dA, dZC, dZA, dD]
            ).reshape(-1)

        return np.concatenate([dy_fields, np.array([dP], dtype=float)])

    def simulate_observables(times_h, pars, return_fields=False):
        times_h = np.asarray(times_h, dtype=float)
        if times_h.ndim != 1 or times_h.size == 0:
            raise ValueError("times_h must be a non-empty 1D array")
        if np.any(np.diff(times_h) < 0.0):
            raise ValueError("times_h must be sorted in nondecreasing order")

        E0 = np.full(N_GRID, E_INIT, dtype=float)
        C0v = np.full(N_GRID, C0_POLY, dtype=float)
        A0v = np.full(N_GRID, A0_POLY, dtype=float)
        ZC0 = np.zeros(N_GRID, dtype=float)
        ZA0 = np.zeros(N_GRID, dtype=float)
        D0 = np.zeros(N_GRID, dtype=float)
        P0 = 0.0

        if has_inhibition:
            ZI0 = np.zeros(N_GRID, dtype=float)
            y0_fields = np.vstack(
                [E0, ZI0, C0v, A0v, ZC0, ZA0, D0]
            ).reshape(-1)
        else:
            y0_fields = np.vstack(
                [E0, C0v, A0v, ZC0, ZA0, D0]
            ).reshape(-1)

        y0 = np.concatenate([y0_fields, np.array([P0], dtype=float)])

        if times_h.size == 1 and times_h[0] == 0.0:
            # Avoid solve_ivp zero-length t_span edge cases.
            sol_t = times_h.copy()
            sol_y = y0[:, None]
        else:
            sol = solve_ivp(
                fun=lambda t, y: rhs_pde(t, y, pars),
                t_span=(float(times_h[0]), float(times_h[-1])),
                y0=y0,
                t_eval=times_h,
                method="BDF",
                rtol=RTOL,
                atol=ATOL,
                max_step=MAX_STEP,
            )

            if (not sol.success) or (not np.all(np.isfinite(sol.y))):
                raise RuntimeError("PDE solver failed: " + str(sol.message))
            sol_t = sol.t
            sol_y = sol.y

        if has_inhibition:
            Yt = sol_y[:-1, :].T.reshape(len(sol_t), 7, N_GRID)
            P = np.maximum(sol_y[-1, :], 0.0)

            E = np.maximum(Yt[:, 0, :], 0.0)
            ZI = np.maximum(Yt[:, 1, :], 0.0)
            C = np.maximum(Yt[:, 2, :], 0.0)
            A = np.maximum(Yt[:, 3, :], 0.0)
            ZC = np.maximum(Yt[:, 4, :], 0.0)
            ZA = np.maximum(Yt[:, 5, :], 0.0)
            D = np.maximum(Yt[:, 6, :], 0.0)
        else:
            Yt = sol_y[:-1, :].T.reshape(len(sol_t), 6, N_GRID)
            P = np.maximum(sol_y[-1, :], 0.0)

            E = np.maximum(Yt[:, 0, :], 0.0)
            C = np.maximum(Yt[:, 1, :], 0.0)
            A = np.maximum(Yt[:, 2, :], 0.0)
            ZC = np.maximum(Yt[:, 3, :], 0.0)
            ZA = np.maximum(Yt[:, 4, :], 0.0)
            D = np.maximum(Yt[:, 5, :], 0.0)

        # Enforce the stated exposed-surface Dirichlet value in saved fields.
        E[:, -1] = E_T

        S = C + A + ZC + ZA + D
        phi = np.clip(1.0 - S / S0, 0.0, 1.0)

        solid_mean = np.mean(S, axis=1)
        phi_mean = np.mean(phi, axis=1)

        # Manuscript observables.
        WL_pct = 100.0 * phi_mean
        crystalline_mean = np.mean(C + ZC, axis=1)
        Xc_pct = 100.0 * crystalline_mean / np.maximum(solid_mean, 1.0e-14)
        PH_model = PH0 - pars["alpha_pH"] * P

        if return_fields:
            D_mean = np.mean(D, axis=1)
            retained_D_fraction, D_integral, remaining_solid_integral = degraded_material_fraction(D, S, DX)
            E_mean = np.mean(E, axis=1)

            fields = {
                "times_h": sol_t.copy(),
                "E": E,
                "C": C,
                "A": A,
                "ZC": ZC,
                "ZA": ZA,
                "D": D,
                "P": P,
                "S": S,
                "phi": phi,
                "solid_mean": solid_mean,
                "phi_mean": phi_mean,
                "D_mean": D_mean,
                "retained_D_fraction": retained_D_fraction,
                "D_integral": D_integral,
                "remaining_solid_integral": remaining_solid_integral,
                "E_mean": E_mean,
                "pH_model": PH_model,
            }

            if has_inhibition:
                ZI_mean = np.mean(ZI, axis=1)
                active_local_fraction = E_mean / np.maximum(E_mean + ZI_mean, 1.0e-14)
                fields.update(
                    {
                        "ZI": ZI,
                        "ZI_mean": ZI_mean,
                        "active_local_fraction": active_local_fraction,
                    }
                )

            return WL_pct, Xc_pct, PH_model, fields

        return WL_pct, Xc_pct, PH_model

    # =====================================================
    # ORDINARY JOINT LEAST SQUARES — NO SCALING / NO WEIGHTING
    # =====================================================

    def residual_blocks(theta):
        pars = unpack_pars(theta, param_names)
        WL_all, Xc_all, PH_all = simulate_observables(t_all_h, pars)

        WL_pred = np.interp(t_W_h, t_all_h, WL_all)
        Xc_pred = np.interp(t_X_h, t_all_h, Xc_all)
        PH_pred = np.interp(t_PH_h, t_all_h, PH_all)

        rW = WL_pred - WL_obs_pct
        rX = Xc_pred - Xc_obs_pct
        rPH = PH_pred - PH_obs
        return rW, rX, rPH

    n_residuals = t_W_h.size + t_X_h.size + t_PH_h.size

    def residuals_theta(theta):
        try:
            if not np.all(np.isfinite(theta)):
                raise FloatingPointError("Non-finite log-parameter")

            rW, rX, rPH = residual_blocks(theta)
            r = np.concatenate([rW, rX, rPH])

            if not np.all(np.isfinite(r)):
                raise FloatingPointError("Non-finite residual")

            return r

        except Exception:
            return np.full(n_residuals, 1.0e6, dtype=float)

    # =====================================================
    # FAST BOUNDED LEAST SQUARES IN LOG SPACE
    # =====================================================

    print("\n" + "=" * 100)
    print(f"{model_variant}: fitting {polymer_grade}")
    print(cfg["description"])
    print("=" * 100)
    print("Residual mode: ordinary joint least squares (unscaled, unweighted)")
    print("Residuals enter the objective in their native numerical units.")
    print(f"Fitted parameters ({len(param_names)}): {', '.join(param_names)}")
    print("Optimizer: local scipy least_squares(method='trf') in bounded log-space")
    print("Initialisation: neutral deterministic vector; paired phase rates start equally")
    print(f"max_nfev={MAX_NFEV}; ftol=xtol=gtol={FTOL:g}")
    print("Physical bounds:")
    for name, lo, hi in zip(param_names, lb_phys, ub_phys):
        unit = "mm^2/h" if name == "De0" else "model units"
        print(f"  {name:10s}: [{lo:.3g}, {hi:.3g}] {unit}")

    res = least_squares(
        fun=residuals_theta,
        x0=THETA0_BASE,
        bounds=(theta_lb, theta_ub),
        method="trf",
        diff_step=1.0e-3,  # FD step in log-space; default (~1e-8) is at ODE-solver noise level
        max_nfev=MAX_NFEV,
        ftol=FTOL,
        xtol=XTOL,
        gtol=GTOL,
    )

    pars_hat = unpack_pars(res.x, param_names)

    # =====================================================
    # LOCAL-OPTIMISER / BOUND DIAGNOSTICS
    # =====================================================

    print("\nLocal TRF convergence check:")
    print(f"  success              : {res.success}")
    print(f"  status               : {res.status}")
    print(f"  message              : {res.message}")
    print(f"  function evaluations : {res.nfev}")
    print(f"  first-order optimality: {res.optimality:.6g}")

    near_bound = False
    print("\nBound check:")
    for name, lo, hi in zip(param_names, lb_phys, ub_phys):
        value = pars_hat[name]
        at_lower = value <= 1.02 * lo
        at_upper = value >= 0.98 * hi
        if at_lower or at_upper:
            near_bound = True
            which = "LOWER" if at_lower else "UPPER"
            print(
                f"  WARNING: {name:10s} = {value:.8g} is near the {which} bound "
                f"[{lo:.3g}, {hi:.3g}]"
            )
        else:
            print(f"  {name:10s} = {value:.8g}")

    if not near_bound:
        print("  No fitted parameter is within 2% of either physical bound.")

    # =====================================================
    # STATISTICS
    # =====================================================

    WL_all, Xc_all, PH_all = simulate_observables(t_all_h, pars_hat)

    WL_fit = np.interp(t_W_h, t_all_h, WL_all)
    Xc_fit = np.interp(t_X_h, t_all_h, Xc_all)
    PH_fit = np.interp(t_PH_h, t_all_h, PH_all)

    WL_res = WL_fit - WL_obs_pct
    Xc_res = Xc_fit - Xc_obs_pct
    PH_res = PH_fit - PH_obs

    # Exact raw joint SSE minimized during fitting.
    residual_sse_raw = float(
        np.sum(WL_res**2) + np.sum(Xc_res**2) + np.sum(PH_res**2)
    )

    # Numerical consistency check against scipy's residual vector.
    objective_check = float(np.sum(res.fun**2))
    if not np.isclose(
        residual_sse_raw, objective_check, rtol=1.0e-7, atol=1.0e-12
    ):
        warnings.warn(
            f"{model_variant} {polymer_grade}: recomputed raw joint SSE "
            f"({residual_sse_raw:.12g}) differs from optimizer objective "
            f"({objective_check:.12g})."
        )

    # All observations used by the optimizer are retained:
    # 9 WL + 9 Xc + 9 pH = 27 observations.
    n_obs = n_residuals
    p_fit = len(param_names)

    # AIC/AICc use the SAME raw joint SSE as the fitting objective.
    AIC, AICc, K_AIC = aic_aicc_from_residual_sse(
        residual_sse_raw,
