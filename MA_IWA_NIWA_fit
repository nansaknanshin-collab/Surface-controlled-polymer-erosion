def r2_score(y_obs, y_hat):
    y_obs = np.asarray(y_obs, dtype=float)
    y_hat = np.asarray(y_hat, dtype=float)
    ss_res = float(np.sum((y_obs - y_hat) ** 2))
    ss_tot = float(np.sum((y_obs - np.mean(y_obs)) ** 2))
    return 1.0 - ss_res / ss_tot if ss_tot > 0.0 else np.nan

def aic_aicc_from_residual_sse(sse, n, p):
    """
    Gaussian AIC/AICc for the exact raw joint residual vector used in fitting.

    Here the residuals are unscaled and unweighted:
        r_WL = WL_pred - WL_obs
        r_Xc = Xc_pred - Xc_obs
        r_pH = pH_pred - pH_obs

    Parameters
    ----------
    sse : float
        SSE of the exact raw residual vector minimized by the optimizer.
    n : int
        Number of fitted observations. Here:
            n = 9 WL + 9 Xc + 9 pH = 27.
    p : int
        Number of fitted mechanistic/model parameters.

    Notes
    -----
    A common residual variance is estimated for the joint residual vector, so

        K = p + 1.

    The additive constant n*log(2*pi) + n is omitted because n is identical
    for every model being compared within a PCL grade. This has no effect on
    Delta AIC/AICc, rankings, or Akaike weights.
    """
    K = int(p) + 1

    if (not np.isfinite(sse)) or sse <= 0.0 or n <= K + 1:
        return np.nan, np.nan, K

    AIC = n * np.log(sse / n) + 2.0 * K
    correction = 2.0 * K * (K + 1.0) / (n - K - 1.0)
    AICc = AIC + correction

    return float(AIC), float(AICc), K

def enzyme_front_diffusion(E, phi, De0, E_surface):
    """
    Surface-gated 1D enzyme transport used by the existing code/manuscript.

    The outermost computational cell is clamped to the prescribed exposed-surface
    enzyme value E_surface. Internal face transport is zero while both adjacent
    cells are intact and opens as local porosity develops.
    """
    E_work = np.maximum(np.asarray(E, dtype=float), 0.0).copy()
    phi = np.clip(np.asarray(phi, dtype=float), 0.0, 1.0)

    # Prescribed exposed-surface active CALB value.
    E_work[-1] = float(E_surface)

    # Existing front-opening rule: an interface opens when either adjacent cell
    # has developed porosity. This preserves the intended erosion-front advance.
    phi_face = np.maximum(phi[:-1], phi[1:])
    Dface = De0 * np.power(phi_face, POROSITY_EXP_ENZYME)
    Jface = -Dface * (E_work[1:] - E_work[:-1]) / DX

    dEdt = np.zeros_like(E_work)
    dEdt[0] = -(Jface[0] - 0.0) / DX
    if N_GRID > 2:
        dEdt[1:-1] = -(Jface[1:] - Jface[:-1]) / DX

    # Dirichlet surface value is imposed directly, not integrated as a state.
    dEdt[-1] = 0.0
    return dEdt, E_work

