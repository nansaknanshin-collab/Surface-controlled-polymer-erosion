# Neutral deterministic initial guess for the local optimiser.
# Related crystalline/amorphous kinetic steps are deliberately started at the
# same value so the initial vector does not build in a preference for either
# pathway. De0 and alpha_pH retain physically/numerically sensible starts.
P0_MAP = {
    "k1": 0.10,
    "kc": 0.10,
    "kr": 0.10,
    "k4": 0.10,
    "ka": 0.10,
    "ke": 0.10,
    "ki": 0.10,
    "De0": 2.0e-3,
    "alpha_pH": 3.0,
}

def parameter_names_for_variant(model_variant):
    cfg = VARIANT_CONFIG[model_variant]
    names = ["k1", "kc"]
    if cfg["has_amorphisation"]:
        names.append("kr")
    names += ["k4", "ka", "ke"]
    if cfg["has_inhibition"]:
        names.append("ki")
    names += ["De0", "alpha_pH"]
    return names

def parameter_bounds_for_variant(param_names):
    """Return common physical and log-space bounds for the active parameter vector."""
    lb = np.full(len(param_names), PARAM_LOWER, dtype=float)
    ub = np.full(len(param_names), PARAM_UPPER, dtype=float)
    return lb, ub, np.log(lb), np.log(ub)

def unpack_pars(theta, param_names):
    """Map unconstrained log-parameters to strictly positive physical parameters."""
    theta = np.asarray(theta, dtype=float)
    if theta.size != len(param_names):
        raise ValueError("theta length does not match parameter vector")
    with np.errstate(over="raise", invalid="raise"):
        q = np.exp(theta)
    if not np.all(np.isfinite(q)):
        raise FloatingPointError("Non-finite physical parameter produced by exp(theta)")
    return dict(zip(param_names, q))

