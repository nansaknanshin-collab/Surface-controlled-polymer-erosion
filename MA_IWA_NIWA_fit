# =========================================================
# SAFE OUTPUT HELPERS
# =========================================================
# Windows/Excel can lock an existing CSV/XLSX/PDF/PNG file.  These helpers
# prevent a completed model run from crashing only because an output file is
# open elsewhere.  If the requested path is locked, a timestamped copy is
# written in the same folder and the run continues.

def timestamped_fallback_path(path):
    path = Path(path)
    stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    return path.with_name(f"{path.stem}_{stamp}{path.suffix}")


def safe_dataframe_to_csv(df, path, **kwargs):
    path = Path(path)
    try:
        df.to_csv(path, **kwargs)
        return path
    except PermissionError:
        alt = timestamped_fallback_path(path)
        df.to_csv(alt, **kwargs)
        print(
            f"  WARNING: could not overwrite {path.name!r}; it is probably open "
            f"in Excel or another program. Saved instead as {alt.name!r}."
        )
        return alt


def _figure_export_kwargs(fig, file_format, kwargs):
    """Bound raster dimensions without changing plotted values or axis limits."""
    options = dict(kwargs)
    options.pop("format", None)
    if file_format not in ("png", "jpg", "jpeg", "tif", "tiff", "webp"):
        return options
    requested = options.get("dpi", fig.dpi)
    requested = float(fig.dpi if requested == "figure" else requested)
    if not np.isfinite(requested) or requested <= 0:
        raise ValueError("Figure DPI must be positive and finite.")
    width, height = fig.get_size_inches()
    pad = float(options.get("pad_inches", plt.rcParams["savefig.pad_inches"]))
    if options.get("bbox_inches") == "tight":
        # Measure the final bounding box at a modest DPI before rasterising.
        old_dpi = fig.dpi
        try:
            fig.set_dpi(72)
            fig.canvas.draw()
            bbox = fig.get_tightbbox(
                fig.canvas.get_renderer(),
                bbox_extra_artists=options.get("bbox_extra_artists"),
            )
            if bbox is not None:
                width, height = bbox.width, bbox.height
        finally:
            fig.set_dpi(old_dpi)
    width, height = max(width + 2 * pad, .01), max(height + 2 * pad, .01)
    allowed = min(requested,
                  np.sqrt(MAX_FIGURE_PIXELS / (width * height)),
                  MAX_FIGURE_SIDE / width, MAX_FIGURE_SIDE / height)
    dpi = max(1, int(np.floor(allowed)))
    options["dpi"] = dpi
    if dpi < requested:
        print(f"  Raster resolution: {dpi} dpi (requested {requested:g}).")
    return options


def _atomic_figure_export(fig, path, **kwargs):
    """Render to an open temporary file, then publish the completed figure."""
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    file_format = kwargs.get("format", path.suffix.lstrip(".")).lower()
    if not file_format:
        raise ValueError("Figure output needs a filename extension or format.")
    options = _figure_export_kwargs(fig, file_format, kwargs)
    fd, temporary_name = tempfile.mkstemp(prefix="fig_", suffix=".tmp", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        # PIL receives an open binary stream rather than reopening a Windows path.
        with os.fdopen(fd, "w+b") as stream:
            fig.savefig(stream, format=file_format, **options)
        try:
            os.replace(temporary, path)
            return path
        except OSError as exc:
            if not (isinstance(exc, PermissionError) or
                    exc.errno in (13, 16, 22) or
                    getattr(exc, "winerror", None) in (5, 32, 87)):
                raise
            # A short, unique name also avoids overwriting a file open elsewhere.
            stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
            alt = path.with_name(
                f"{path.stem[:80]}_{stamp}_{uuid.uuid4().hex[:8]}{path.suffix}")
            os.replace(temporary, alt)
            print(f"  Could not replace {path.name!r}: {exc}. Saved {alt.name!r}.")
            return alt
    finally:
        temporary.unlink(missing_ok=True)


def safe_figure_savefig(fig, path, **kwargs):
    """Save every PNG's SVG first, then export the requested figure safely."""
    path = Path(path)
    svg_path = None
    if path.suffix.lower() == ".png":
        svg_options = dict(kwargs)
        svg_options.pop("format", None)
        svg_options.pop("dpi", None)
        svg_options.pop("pil_kwargs", None)
        svg_path = _atomic_figure_export(fig, path.with_suffix(".svg"), **svg_options)
    try:
        return _atomic_figure_export(fig, path, **kwargs)
    except OSError as exc:
        if svg_path is None:
            raise
        print(f"  PNG export failed: {exc}. Vector figure saved as {svg_path.name!r}.")
        return svg_path


def safe_results_workbook(all_df, comparison_df, path):
    path = Path(path)

    def _write(target):
        with pd.ExcelWriter(target) as writer:
            all_df.to_excel(writer, sheet_name="all_fits", index=False)
            comparison_df.to_excel(writer, sheet_name="AICc_comparison", index=False)

    try:
        _write(path)
        return path
    except PermissionError:
        alt = timestamped_fallback_path(path)
        _write(alt)
        print(
            f"  WARNING: could not overwrite {path.name!r}; it is probably open "
            f"in Excel. Saved instead as {alt.name!r}."
        )
        return alt

