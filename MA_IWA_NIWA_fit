    else:
        K_M_eff = np.nan

    if has_inhibition:
        total_Inh_flux = TRAPZ(
            np.mean(pars_hat["ki"] * E * P[:, None], axis=1),
            t_plot_h,
        )
        K_Inh_eff = total_Inh_flux / E_exposure if E_exposure > 0.0 else np.nan
    else:
        K_Inh_eff = np.nan

    K_Erode_eff = pars_hat["ke"]

    dense = pd.DataFrame(
        {
            "time_h": t_plot_h,
