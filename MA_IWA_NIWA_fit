def main():
    print("\n" + "#" * 104)
    print("MA et al. PCL/CALB — MANUSCRIPT-ALIGNED IWA–NIWA FIT")
    print("#" * 104)
    print(f"Output folder: {ROOT_OUTPUT_DIR}")
    print("Supervisor-approved models:", ", ".join(RUN_VARIANTS))
    print("Fit: ordinary joint least squares on WL(%), Xc(%), and pH; no scaling and no weighting.")
    print("Information criteria: raw joint residual SSE; n=27; K=p+1 including one common residual variance.")
    print("Product state: P(t) is free released product.")
    print("Inhibition: E + P -> ZI, with P consumed by the same inhibition flux.")
    print("Boundary: E(L,t) = E_T is fixed for all four variants; no bath-enzyme state.")
    print("Optimizer: local bounded scipy least_squares (TRF) in log-space; no PSO.")
    print("Initial guess: neutral deterministic start with equal initial kinetic rates (0.1) for paired pathways.")
    print(f"Bounds: [{PARAM_LOWER:g}, {PARAM_UPPER:g}] for ALL fitted parameters.")
    print(f"MAX_NFEV={MAX_NFEV}; ftol=xtol=gtol={FTOL:g}.")
    print("Plot settings: figsize=(8, 5.5), DPI=600, line width=5, marker size=10.")
    print("IWA red solid; IWOA blue dashed; NIWA green dash-dot; NINA orange dotted.")

    all_results = []

    for model_variant in RUN_VARIANTS:
        print("\n" + "#" * 104)
        print(f"MODEL VARIANT: {model_variant} — {VARIANT_CONFIG[model_variant]['description']}")
        print("#" * 104)

        model_results = []
        model_dir = ROOT_OUTPUT_DIR / model_variant
        model_dir.mkdir(parents=True, exist_ok=True)

        for grade in GRADE_ORDER:
            try:
                result = fit_polymer_grade(
                    model_variant,
                    grade,
                    ALL_POLYMER_DATA[grade],
                )
                model_results.append(result)
                all_results.append(result)

                model_df = pd.DataFrame(model_results)
                model_df.to_csv(
                    model_dir / f"MA_{model_variant}_all_grades_summary.csv",
                    index=False,
                )
                model_df.to_excel(
                    model_dir / f"MA_{model_variant}_all_grades_summary.xlsx",
                    index=False,
                )

                all_df = pd.DataFrame(all_results)
                all_df.to_csv(
                    ROOT_OUTPUT_DIR / "MA_all_four_models_all_grades_summary.csv",
                    index=False,
                )

            except Exception as exc:
                print("\n" + "!" * 104)
                print(f"{model_variant} {grade} — FIT FAILED")
                print(type(exc).__name__ + ": " + str(exc))
                print("Continuing to next grade/model.")
                print("!" * 104)

    if not all_results:
        print("\nNo successful fits were completed.")
        return

    all_df = pd.DataFrame(all_results)
    comparison_df = build_model_comparison(all_df)

    all_df.to_csv(
        ROOT_OUTPUT_DIR / "MA_all_four_models_all_grades_summary.csv",
        index=False,
    )
    comparison_df.to_csv(
        ROOT_OUTPUT_DIR / "MA_model_comparison_AICc.csv",
        index=False,
    )

    safe_results_workbook(
        all_df,
        comparison_df,
        ROOT_OUTPUT_DIR / "MA_four_model_results_and_AICc_comparison.xlsx",
    )

    # Overlay all model fits against each experimental response for each grade.
    create_combined_model_plots(all_df)

    print("\n" + "=" * 104)
    print("FINAL MODEL COMPARISON")
    print("=" * 104)

    cols = [
        "Polymer",
        "Model",
        "n_parameters",
        "K_AIC",
        "n_observations",
        "R2_WL",
        "R2_Xc",
        "R2_pH",
        "Residual_SSE_raw_joint",
        "AIC_raw_joint_WL_Xc_pH",
        "AICc_raw_joint_WL_Xc_pH",
        "Delta_AICc",
        "Akaike_weight",
        "AICc_rank",
    ]
    print(comparison_df[cols].to_string(index=False))

    print("\nPreferred model by grade (minimum AICc):")
    for grade in GRADE_ORDER:
        g = comparison_df.loc[comparison_df["Polymer"] == grade]
        if g.empty:
            continue
        gfinite = g[np.isfinite(g["AICc_raw_joint_WL_Xc_pH"])]
        if gfinite.empty:
            print(f"  {grade}: no finite AICc")
        else:
            best = gfinite.sort_values("AICc_raw_joint_WL_Xc_pH").iloc[0]
            print(
                f"  {grade}: {best['Model']} "
                f"(AICc={best['AICc_raw_joint_WL_Xc_pH']:.6g}, "
                f"Delta={best['Delta_AICc']:.6g}, "
                f"weight={best['Akaike_weight']:.6g})"
            )

if __name__ == "__main__":
    import sys
    with warnings.catch_warnings():
        warnings.simplefilter("default")
        if PLOTS_ONLY or '--combined-plots-only' in sys.argv:
            plot_saved_comparisons()
        else:
            main()
