    r2_WL = r2_score(WL_obs_pct, WL_fit)
    r2_Xc = r2_score(Xc_obs_pct, Xc_fit)
    r2_PH = r2_score(PH_obs, PH_fit)

    print("\nEstimated parameters:")
    for name in param_names:
        if name == "De0":
            unit = "mm^2/h"
        elif name == "alpha_pH":
            unit = "pH units / free-product unit"
        else:
            unit = "1/h on normalized model scale"
        print(f"  {name:10s} = {pars_hat[name]:.8g} [{unit}]")

    print(f"\nR^2 WL  = {r2_WL:.6f}")
    print(f"R^2 Xc  = {r2_Xc:.6f}")
    print(f"R^2 pH  = {r2_PH:.6f}")
    print(f"Raw joint SSE (fit)   = {residual_sse_raw:.8g}")
    print(f"n       = {n_obs} observations (9 WL + 9 Xc + 9 pH)")
    print(f"p       = {p_fit} mechanistic parameters")
    print(f"K_AIC   = {K_AIC} = p + 1 residual-variance parameter")
    print(f"AIC     = {AIC:.8g}")
    print(f"AICc    = {AICc:.8g}")

    # =====================================================
    # DENSE OUTPUTS + PDE-TO-CA EFFECTIVE RATES
    # =====================================================

    t_plot_h = np.linspace(0.0, float(t_all_h[-1]), 600)
    WL_plot, Xc_plot, PH_plot, fields = simulate_observables(
